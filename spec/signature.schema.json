{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "exam-uncheat.signature/v1",
  "type": "object",
  "required": ["schema", "signatures"],
  "properties": {
    "schema": {"const": "exam-uncheat.signature/v1"},
    "license": {"type": "string"},
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "match", "confidence", "weight", "sources", "verified_by", "spoofable"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
          "name": {"type": "string"},
          "category": {"enum": ["smart_glasses", "earbuds", "hidden_camera", "phone_hotspot", "wifi_direct", "tracker", "radio_tx", "other"]},
          "vendor": {"type": "string"},
          "match": {"$ref": "#/$defs/match"},
          "confidence": {"enum": ["low", "medium", "high"]},
          "weight": {"type": "integer", "minimum": 0, "maximum": 100},
          "notes": {"type": "array", "items": {"type": "string"}},
          "spoofable": {"type": "boolean"},
          "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^https://"}},
          "last_verified": {"type": "string"},
          "verified_by": {"enum": ["literature", "bench", "field", "heuristic"]}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "cond": {
      "type": "object",
      "properties": {
        "field": {"type": "string"},
        "eq": {}, "in": {"type": "array"}, "contains": {}, "regex": {"type": "string"},
        "prefix": {"type": "string"}, "hex_prefix": {"type": "string"}, "exists": {"type": "boolean"},
        "all": {"type": "array", "items": {"$ref": "#/$defs/cond"}},
        "any": {"type": "array", "items": {"$ref": "#/$defs/cond"}}
      }
    },
    "match": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]},
        "all": {"type": "array", "items": {"$ref": "#/$defs/cond"}},
        "any": {"type": "array", "items": {"$ref": "#/$defs/cond"}}
      }
    }
  }
}
